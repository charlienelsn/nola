{
  "name": "nola",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "check:terminology": "bash scripts/check-terminology.sh",
    "seed": "pnpm --filter @nola/api seed",
    "reset": "supabase db reset --yes && pnpm seed"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "^5.6.3"
  }
}
